# 忽略所有隐藏文件和目录
.*
# 但不忽略特定隐藏文件和目录
!.env.example
!.gitignore
!.github/

# 敏感文件
*.pem
*_key
*_secret
*.key
*.crt

# IDE和编辑器文件
*.swp
*.swo

# 构建和依赖文件
node_modules/
/dist/
/build/
*.log
# 验收证据日志需要入库，覆盖上面的 *.log 规则
!docs/evidence/*.log

# 临时文件
tmp/
temp/
logs/
*.pid

# 本地备份产物（如 WeKnora-lite.bak），体积大，勿入库
*.bak

WeKnora
WeKnora-lite
cmd/desktop/build/bin/
/models/
test/data/mswag.txt
data/files/
data/weknora.db
data/weknora.db-wal
data/weknora.db-shm
skills-lock.json

web/

**/__pycache__
/scripts/scale_dev_jobs.sh
/server
frontend/.vite
frontend/chrome-extension/
WeKnora-Chrome-Extension
packages/protoc-3.19.4-linux-x86_64.zip

Claude.md

# 本地测试脚本
configure-ollama.sh
fix-docker.sh

# WeChat Mini Program local/private configuration
miniprogram/project.private.config.json

# Staging dir for the Docker sandbox self-check probe (removed after each run)
.weknora-sandbox-check-*

# Locally built BrowserSkill runtime and extension bundles
/artifacts/browserskill/

# Content-addressed blob store written at the repo root by the local storage
# backend (uploaded user documents). Never commit these.
/blobs/
