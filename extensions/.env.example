# Documentation only: the Host reads process environment, never this file.
# Default mode has no database/API side effects.
AGENTRAG_MODE=probe
AGENTRAG_SHUTDOWN_TIMEOUT=10s

# To enable durable background work, provide ALL values in process environment.
# AGENTRAG_MODE=worker
# AGENTRAG_EXT_DB=D:/AgentRAG-data/agentrag_ext.db
# AGENTRAG_WEKNORA_URL=http://127.0.0.1:8080
# AGENTRAG_WEKNORA_API_KEY=
# AGENTRAG_TENANT_ID=7
# AGENTRAG_KB_IDS=kb-a,kb-b
# AGENTRAG_RECONCILE_INTERVAL=1m
# AGENTRAG_OUTBOX_POLL_INTERVAL=1s
# AGENTRAG_OUTBOX_LEASE=1m
# AGENTRAG_OUTBOX_RETRY_DELAY=5s
# AGENTRAG_OUTBOX_MAX_ATTEMPTS=5
