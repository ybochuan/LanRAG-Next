# Copy to %LOCALAPPDATA%/LanRAG Lite/.env.lite before setting external services.
# Leave these empty to start without a separately configured parser.
DOCREADER_ADDR=
DOCREADER_TRANSPORT=grpc

# Enable the MinerU route only when a compatible endpoint is available.
AGENTRAG_PARSER_UPSTREAM_URL=
AGENTRAG_PARSER_UPSTREAM_KEY=

# Optional search directory for older model instances saved by model filename.
# New instances use the GGUF file selected in the desktop window.
MODEL_SUPERVISOR_MODEL_DIR=

# Keep cold startup independent of the DuckDB extension server.
# Use 0 only if the Excel/spatial features are needed and egress is available.
DUCKDB_SKIP_EXTENSION_LOAD=1
